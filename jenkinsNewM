pipeline {
  agent any

  tools {
    maven 'maven-3.9.9'
  }

  stages {
    stage('Checkout Code') {
      steps {
      git branch: 'qa', credentialsId: 'db882271-4e7f-4b68-ae8f-db45f8e9cf66', url: 'https://github.com/Idea-Better-5g/demo-java.git'
        }
      }
    
    stage('Compile') {
      steps {
        sh 'mvn compile'
      }
    }
    stage('Build') {
      steps {
        sh 'mvn clean package'
      }
    }
  }
  post {
    success {
      echo "Pipeline executed successfully for branch: ${env.BRANCH_NAME}"
    }
    failure {
      echo "Pipeline failed for branch: ${env.BRANCH_NAME}"
    }
  }
}
